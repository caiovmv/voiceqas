      "id": 5,
      "targets": [{ "expr": "voiceqas_vqa_composite_score", "legendFormat": "composite", "refId": "A" }],
      "title": "VQA Composite Score",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },

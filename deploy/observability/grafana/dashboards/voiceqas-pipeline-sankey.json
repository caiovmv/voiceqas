    {
      "datasource": {
        "type": "marcusolsson-json-datasource",
        "uid": "voiceqas-api"
      },
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 20,
      "options": {
        "renderer": "canvas",
        "editor": {
          "format": "auto"
        },
        "getOption": "const frame = context.panel.data.series?.[0];\nif (!frame) {\n  return { title: { text: 'Sem dados de pipeline' }, series: [{ type: 'sankey', data: [], links: [] }] };\n}\nconst field = frame.fields?.find((f) => f.name === 'echarts');\nconst raw = field?.values?.[0] ?? field?.values?.buffer?.[0];\nif (!raw) {\n  return { title: { text: 'Aguardando tráfego (Tester ou RTP UDP :10000)' }, series: [{ type: 'sankey', data: [], links: [] }] };\n}\nconst opt = typeof raw === 'string' ? JSON.parse(raw) : raw;\nconst links = opt?.series?.[0]?.links ?? [];\nif (!links.length) {\n  return {\n    title: {\n      text: 'Pipeline Sankey — sem fluxo ativo',\n      subtext: 'Envie áudio no Tester (#tester) ou via RTP UDP :10000',\n    },\n    series: [{ type: 'sankey', data: [{ name: 'aguardando' }], links: [] }],\n  };\n}\nopt.title = {\n  text: 'Pipeline Sankey — ' + (context.grafana.replaceVariables('${scope:raw}') || 'fleet'),\n  subtext: links.length + ' links ativos',\n};\nreturn opt;"
      },
      "pluginVersion": "7.2.5",
      "targets": [
        {
          "cacheDurationSeconds": 0,
          "datasource": {
            "type": "marcusolsson-json-datasource",
            "uid": "voiceqas-api"
          },
          "fields": [
            {
              "jsonPath": "$.echarts",
              "language": "jsonpath",
              "name": "echarts"
            },
            {
              "jsonPath": "$.scope",
              "language": "jsonpath",
              "name": "scope"
            }
          ],
          "method": "GET",
          "queryParams": "session_id=${session_id}",
          "refId": "A",
          "urlPath": "/v1/ops/pipeline/snapshot"
        }
      ],
      "title": "Audio Pipeline Sankey",
      "type": "volkovlabs-echarts-panel"
    },

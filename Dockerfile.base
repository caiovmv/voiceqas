# syntax=docker/dockerfile:1
#
# voiceqas-build-base: toolchain + vcpkg deps BAKED into image layers.
# Rebuild ONLY when vcpkg.json / vcpkg-configuration.json / baseline change:
#
#   docker build -f Dockerfile.base -t voiceqas-build-base:local .
#   ./scripts/build-base.ps1
#
# App Dockerfile then compiles only your code (minutes, not hours).

ARG GCC_VERSION=15
ARG CMAKE_MIN_VERSION=3.31
ARG VCPKG_BASELINE=d87340acc46bdeda386037b38aca30136e667e47

FROM gcc:${GCC_VERSION}-bookworm

ARG CMAKE_MIN_VERSION
ARG VCPKG_BASELINE
ARG VOICEQAS_BUILD_TESTS=OFF

ENV DEBIAN_FRONTEND=noninteractive \
    VCPKG_ROOT=/opt/vcpkg \
    VCPKG_DEFAULT_TRIPLET=x64-linux \
    VCPKG_FEATURE_FLAGS=manifests,versions \
    CMAKE_TOOLCHAIN_FILE=/opt/vcpkg/scripts/buildsystems/vcpkg.cmake \
    VCPKG_INSTALLED_DIR=/opt/vcpkg-installed \
    VCPKG_BINARY_SOURCES=clear;files,/opt/vcpkg/bincache,readwrite \
    CMAKE_MAKE_PROGRAM=/usr/bin/ninja \
    CMAKE_CXX_COMPILER=/usr/local/bin/g++ \
    CMAKE_C_COMPILER=/usr/local/bin/gcc \
    CCACHE_DIR=/root/.ccache \
    CCACHE_MAXSIZE=2G \
    CMAKE_CXX_COMPILER_LAUNCHER=ccache \
    CMAKE_C_COMPILER_LAUNCHER=ccache \
    VOICEQAS_BUILD_TESTS=${VOICEQAS_BUILD_TESTS}

RUN apt-get update && apt-get install -y --no-install-recommends \
        ninja-build \
        git \
        curl \
        zip \
        unzip \
        tar \
        pkg-config \
        ca-certificates \
        python3-pip \
        ccache \
        autoconf \
        autoconf-archive \
        automake \
        libtool \
    && pip3 install --break-system-packages "cmake>=${CMAKE_MIN_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/microsoft/vcpkg.git "${VCPKG_ROOT}" \
    && cd "${VCPKG_ROOT}" \
    && git checkout "${VCPKG_BASELINE}" \
    && "${VCPKG_ROOT}/bootstrap-vcpkg.sh" -disableMetrics

WORKDIR /opt/voiceqas-manifest
COPY vcpkg.json vcpkg-configuration.json ./

# Cache mounts speed up THIS base build; install root is committed to the image layer.
SHELL ["/bin/bash", "-eo", "pipefail", "-c"]
RUN --mount=type=cache,target=/opt/vcpkg/downloads,id=voiceqas-vcpkg-dl \
    --mount=type=cache,target=/opt/vcpkg/buildtrees,id=voiceqas-vcpkg-bt \
    --mount=type=cache,target=/opt/vcpkg/packages,id=voiceqas-vcpkg-pkg \
    --mount=type=cache,target=/opt/vcpkg/bincache,id=voiceqas-vcpkg-bin \
    bash -c 'FEATURE_ARGS=(); \
      if [[ "${VOICEQAS_BUILD_TESTS}" == "ON" ]]; then FEATURE_ARGS+=(--x-feature=test); fi; \
      "${VCPKG_ROOT}/vcpkg" install \
        --triplet "${VCPKG_DEFAULT_TRIPLET}" \
        --x-manifest-root=/opt/voiceqas-manifest \
        --x-install-root="${VCPKG_INSTALLED_DIR}" \
        "${FEATURE_ARGS[@]}"'

LABEL org.opencontainers.image.title="voiceqas-build-base" \
      org.opencontainers.image.description="GCC15 + vcpkg deps baked for VoiceQAS app builds"

CMD ["bash"]